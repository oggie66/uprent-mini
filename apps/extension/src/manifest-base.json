{
  "manifest_version": 3,
  "name": "Uprent mini",
  "description": "A personal rental-search companion for Pararius.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*"],
  "action": {
    "default_icon": "icons/192x192.png"
  },
  "background": {
    "service_worker": "service-worker/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pararius.com/*", "https://www.pararius.nl/*"],
      "js": ["content-scripts/main.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost/*"]
  }
}
